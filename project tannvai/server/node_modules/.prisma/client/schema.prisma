datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("CITIZEN") // CITIZEN, COORDINATOR, REVIEWER, ADMIN
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports         IncidentReport[] @relation("ReportAuthor")
  verifiedReports IncidentReport[] @relation("ReportVerifier")
  assignments     Assignment[]     @relation("UserAssignments")
  auditLogs       AuditLog[]       @relation("UserAudits")
}

model IncidentReport {
  id              String    @id @default(cuid())
  title           String
  rawDescription  String
  category        String    @default("OTHER") // FLOOD, ROAD_HAZARD, FIRE, STRUCTURAL_DAMAGE, MEDICAL_EMERGENCY, UTILITY_OUTAGE, SHELTER_REQUEST, OTHER
  status          String    @default("UNVERIFIED") // UNVERIFIED, UNDER_REVIEW, VERIFIED, RESOLVED, FLAGGED_CONFLICT
  urgency         String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  locationName    String
  latitude        Float
  longitude       Float
  imageUrl        String?
  reporterName    String?
  reporterContact String? // PII: Strictly confidential, never exposed on public map
  reporterConsent Boolean   @default(true)
  isConflicting   Boolean   @default(false)
  conflictNotes   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  verifiedAt      DateTime?

  reporterId   String?
  reporter     User?   @relation("ReportAuthor", fields: [reporterId], references: [id])
  verifiedById String?
  verifiedBy   User?   @relation("ReportVerifier", fields: [verifiedById], references: [id])

  analysis          IncidentAnalysis?
  helpRequests      HelpRequest[]
  primaryDuplicates DuplicateSuggestion[] @relation("PrimaryReportDuplicates")
  matchedDuplicates DuplicateSuggestion[] @relation("MatchedReportDuplicates")
}

model IncidentAnalysis {
  id                 String         @id @default(cuid())
  reportId           String         @unique
  report             IncidentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  extractedCategory  String
  extractedNeeds     String // JSON string array of needs: ["drinking_water", "debris_clearing"]
  extractedLocation  String
  extractedTimeframe String?
  structuredSummary  String
  urgencyRationale   String // Explainable reasoning
  confidenceScore    Float          @default(0.85)
  modelProvider      String         @default("ResQNet-AI-Engine")
  isVerified         Boolean        @default(false)
  createdAt          DateTime       @default(now())
}

model DuplicateSuggestion {
  id              String         @id @default(cuid())
  primaryReportId String
  primaryReport   IncidentReport @relation("PrimaryReportDuplicates", fields: [primaryReportId], references: [id], onDelete: Cascade)
  matchedReportId String
  matchedReport   IncidentReport @relation("MatchedReportDuplicates", fields: [matchedReportId], references: [id], onDelete: Cascade)
  similarityScore Float
  distanceMeters  Float
  matchRationale  String
  status          String         @default("PENDING") // PENDING, CONFIRMED_DUPLICATE, REJECTED, CORROBORATING_REPORT
  reviewedById    String?
  reviewNotes     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Resource {
  id             String   @id @default(cuid())
  name           String
  type           String // PERSONNEL, VEHICLE, SUPPLY, EQUIPMENT, SHELTER
  capacity       Int      @default(1)
  availableCount Int      @default(1)
  status         String   @default("AVAILABLE") // AVAILABLE, DEPLOYED, MAINTENANCE, STANDBY
  location       String
  contactPerson  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments Assignment[]
}

model HelpRequest {
  id               String          @id @default(cuid())
  reportId         String?
  report           IncidentReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  requestType      String // FOOD, WATER, SHELTER, MEDICAL, EVACUATION, POWER, OTHER
  description      String
  urgency          String          @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status           String          @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, VERIFIED, ASSIGNED, RESOLVED
  peopleCount      Int             @default(1)
  specialNeeds     String?
  requesterName    String?
  requesterContact String? // PII protected
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  assignments Assignment[]
}

model Assignment {
  id            String       @id @default(cuid())
  helpRequestId String?
  helpRequest   HelpRequest? @relation(fields: [helpRequestId], references: [id], onDelete: SetNull)
  resourceId    String
  resource      Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  assignedById  String?
  assignedBy    User?        @relation("UserAssignments", fields: [assignedById], references: [id])
  assignedAt    DateTime     @default(now())
  status        String       @default("ASSIGNED") // ASSIGNED, EN_ROUTE, ON_SCENE, COMPLETED, CANCELLED
  notes         String?
  completedAt   DateTime?
}

model AuditLog {
  id              String   @id @default(cuid())
  entityType      String // INCIDENT, ANALYSIS, DUPLICATE, HELP_REQUEST, ASSIGNMENT, SYSTEM
  entityId        String
  action          String // CREATED, UPDATED, VERIFIED, STATUS_CHANGED, DUPLICATE_LINKED, DUPLICATE_REJECTED, RESOURCE_ASSIGNED, CONFLICT_FLAGGED, RESOLVED
  performedById   String?
  performedBy     User?    @relation("UserAudits", fields: [performedById], references: [id])
  performedByName String   @default("System")
  performedByRole String   @default("SYSTEM")
  previousState   String?
  newState        String?
  notes           String?
  createdAt       DateTime @default(now())
}
